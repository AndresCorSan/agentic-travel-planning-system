# Copy to .env (gitignored, never committed) and fill in the required key.
# Optional variables below show their defaults; uncomment to override.

# ---- Required: LLMs run through OpenRouter (no other keys needed — MCP
# servers require no personal credentials).
OPENROUTER_API_KEY=sk-or-v1-...

# ---- Optional (defaults apply when unset):
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# LIGHT_LLM_FALLBACKS=google/gemma-3-27b-it,z-ai/glm-5.3-flash

# DATABASE_URL and CHECKPOINT_DB_URL: replace <backend> with the absolute
# path to src/backend (defaults already point there — leave commented normally).
# DATABASE_URL=sqlite+aiosqlite:///<backend>/data/app.db
# CHECKPOINT_DB_URL=<backend>/data/checkpoints.db

# LangSmith (optional): LangChain picks these up automatically, no code
# changes needed. Each turn already carries conversation_id + the
# "travel-planner" tag (see api/v1/streaming.py::trace_config). Get a key
# at https://smith.langchain.com. Leave commented to run without tracing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT="Agentic Travel Planning System"
